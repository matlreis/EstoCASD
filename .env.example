DJANGO_SECRET_KEY="your-django-secret-key"
DB_NAME=estocasd_db
DB_USER=estocasd
DB_PASSWORD="your_user_password"
# Provedores compatíveis com a API da OpenAI: OpenRouter, Ollama, Gemini...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY="your-openrouter-api-key"
LLM_MODEL=provider/model-name:free
# Configuração do envio de alertas por e-mail (opcional). 
# Sem SMTP_HOST, os e-mails são impressos no terminal (desenvolvimento)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.account@gmail.com
# SMTP_PASSWORD="your-app-password"
# DEFAULT_FROM_EMAIL="EstoCASD <your.account@gmail.com>"